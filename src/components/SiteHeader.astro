---
import { normalizePathname, siteConfig } from '../config/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const normalizedCurrentPath = normalizePathname(currentPath);
---

<header class="border-b border-gray-200/70 dark:border-neutral-800">
  <div class="relative mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
    <a href="/" class="font-semibold tracking-wide">AIAU</a>
    <button
      id="menu-button"
      class="inline-flex items-center justify-center rounded-md p-2 text-gray-700 hover:bg-gray-100 dark:text-neutral-200 dark:hover:bg-neutral-800 md:hidden"
      aria-controls="site-nav"
      aria-expanded="false"
      aria-label="メニューを開閉"
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
    <nav
      id="site-nav"
      aria-label="メイン"
      class="absolute left-0 right-0 top-full z-20 flex origin-top flex-col gap-2 border-b border-gray-200 bg-white p-3 text-sm opacity-0 transition-all duration-200 ease-out pointer-events-none -translate-y-2 scale-95 dark:border-neutral-800 dark:bg-neutral-950 md:static md:flex md:flex-row md:items-center md:gap-4 md:border-0 md:bg-transparent md:p-0 md:opacity-100 md:pointer-events-auto md:translate-y-0 md:scale-100"
    >
      {
        siteConfig.navLinks.map((link) => {
          const isCurrent = normalizePathname(link.href) === normalizedCurrentPath;
          return (
            <a class="hover:underline" href={link.href} aria-current={isCurrent ? 'page' : undefined}>
              {link.label}
            </a>
          );
        })
      }
      <a
        class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-[#5865F2] px-3 py-1.5 text-white hover:bg-[#4752C4] md:w-auto"
        href={siteConfig.communityLinks.discord}
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="fa-brands fa-discord text-[16px]" aria-hidden="true"></i>
        <span>コミュニティに参加</span>
      </a>
    </nav>
  </div>
</header>

<script is:inline type="module" src="/scripts/site-navigation.js"></script>
