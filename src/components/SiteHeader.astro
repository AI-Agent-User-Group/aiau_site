---
import { normalizePathname, siteConfig } from '../config/site';
import { renderLucideIcon } from '../lib/lucide';
import { Menu, X } from 'lucide';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const normalizedCurrentPath = normalizePathname(currentPath);
---

<header class="sticky top-0 z-30 border-b border-hairline bg-canvas/90 backdrop-blur-sm dark:border-dark-hairline dark:bg-dark-canvas/90">
  <div class="relative mx-auto flex max-w-[1100px] items-center justify-between px-6 py-4">
    <a href="/" class="text-lg font-normal tracking-tight text-ink transition-colors hover:text-primary dark:text-canvas">
      AIAU
    </a>
    <button
      id="menu-button"
      class="inline-flex items-center justify-center rounded-md p-2 text-body transition-colors hover:bg-canvas-soft dark:text-muted dark:hover:bg-dark-surface md:hidden"
      aria-controls="site-nav"
      aria-expanded="false"
      aria-label="メニューを開閉"
    >
      <span id="menu-icon-open">
        <Fragment set:html={renderLucideIcon(Menu, { width: 20, height: 20 })} />
      </span>
      <span id="menu-icon-close" class="hidden">
        <Fragment set:html={renderLucideIcon(X, { width: 20, height: 20 })} />
      </span>
    </button>
    <nav
      id="site-nav"
      aria-label="メイン"
      class="absolute left-0 right-0 top-full z-20 flex origin-top flex-col gap-1 border-b border-hairline bg-canvas p-4 opacity-0 transition-opacity duration-200 ease-out pointer-events-none -translate-y-2 dark:border-dark-hairline dark:bg-dark-canvas md:static md:flex md:flex-row md:items-center md:gap-1 md:border-0 md:bg-transparent md:p-0 md:opacity-100 md:pointer-events-auto md:translate-y-0"
    >
      {
        siteConfig.navLinks.map((link) => {
          const isCurrent = normalizePathname(link.href) === normalizedCurrentPath;
          return (
            <a
              class:list={[
                'rounded-md px-3 py-2 text-sm font-medium transition-colors',
                isCurrent
                  ? 'text-primary'
                  : 'text-body hover:text-ink dark:text-muted dark:hover:text-canvas',
              ]}
              href={link.href}
              aria-current={isCurrent ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
      <a
        class="mt-2 inline-flex w-full items-center justify-center gap-2 rounded-md bg-ink px-4 py-2 text-sm font-medium text-canvas transition-colors hover:bg-primary md:mt-0 md:w-auto dark:bg-canvas dark:text-ink"
        href={siteConfig.communityLinks.discord}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>コミュニティに参加</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.getElementById('menu-button')!;
  const siteNav = document.getElementById('site-nav')!;
  const iconOpen = document.getElementById('menu-icon-open')!;
  const iconClose = document.getElementById('menu-icon-close')!;

  let isOpen = false;

  function toggleMenu() {
    isOpen = !isOpen;
    menuButton.setAttribute('aria-expanded', String(isOpen));

    if (isOpen) {
      iconOpen.classList.add('hidden');
      iconClose.classList.remove('hidden');
      siteNav.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-2');
      siteNav.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
    } else {
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
      siteNav.classList.add('opacity-0', 'pointer-events-none', '-translate-y-2');
      siteNav.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
    }
  }

  menuButton.addEventListener('click', toggleMenu);

  document.addEventListener('click', (e) => {
    if (isOpen && !menuButton.contains(e.target as Node) && !siteNav.contains(e.target as Node)) {
      toggleMenu();
    }
  });
</script>
