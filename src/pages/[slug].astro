---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReportSection from '../components/ReportSection.astro';
import { toAbsoluteUrl } from '../config/site';

export async function getStaticPaths() {
  const policies = await getCollection('policies');
  return policies.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'policies'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const pageName = entry.data.metaTitle.replace(/\s+\|\s+AIAU$/, '');
---

<BaseLayout
  title={entry.data.metaTitle}
  description={entry.data.description}
  canonicalPath={`/${entry.id}/`}
  ogImage={entry.data.ogImage}
  type={entry.data.type}
  breadcrumb={[
    { name: 'TOP', item: toAbsoluteUrl('/') },
    { name: pageName, item: toAbsoluteUrl(`/${entry.id}/`) },
  ]}
>
  <div class="mx-auto max-w-3xl">
    <article class="prose prose-zinc max-w-none dark:prose-invert">
      <Content />
    </article>
  </div>
  <ReportSection />
</BaseLayout>
