---
import BaseLayout from '../layouts/BaseLayout.astro';
import { notFoundPageMetadata } from '../data/site-pages';
import Button from '../components/Button.astro';
import ReportSection from '../components/ReportSection.astro';
import { renderLucideIcon } from '../lib/lucide';
import { Home } from 'lucide';
---

<BaseLayout {...notFoundPageMetadata}>
  <section class="flex flex-col items-center justify-center py-28 text-center">
    <h1 class="text-9xl font-normal tracking-tight text-hairline dark:text-dark-hairline">404</h1>
    <p class="mt-8 text-xl font-medium text-ink dark:text-canvas">ページが見つかりません</p>
    <p class="mt-2 text-body">URLをご確認の上、TOPへお戻りください。</p>
    <div class="mt-8">
      <Button href="/" variant="primary" size="lg">
        <Fragment set:html={renderLucideIcon(Home, { width: 18, height: 18 })} />
        <span>TOPへ戻る</span>
      </Button>
    </div>
  </section>
  <ReportSection />
</BaseLayout>
