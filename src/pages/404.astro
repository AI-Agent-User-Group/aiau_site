---
import BaseLayout from '../layouts/BaseLayout.astro';
import { notFoundPageMetadata } from '../data/site-pages';
---

<BaseLayout {...notFoundPageMetadata}>
  <section class="py-16 text-center">
    <h1 class="text-3xl font-bold">ページが見つかりません</h1>
    <p class="mt-3 text-gray-600 dark:text-neutral-300">URLをご確認ください。TOPへお戻りください。</p>
    <div class="mt-6">
      <a
        href="/"
        class="inline-flex items-center rounded-md bg-gray-900 px-4 py-2 text-white hover:bg-gray-800 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-white"
      >
        TOPへ戻る
      </a>
    </div>
  </section>
</BaseLayout>
