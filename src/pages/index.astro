---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { homePageMetadata } from '../data/site-pages';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import ReportSection from '../components/ReportSection.astro';
import { renderLucideIcon } from '../lib/lucide';
import { MessageSquare, Calendar, ArrowRight } from 'lucide';
---

<BaseLayout {...homePageMetadata}>
  <!-- Hero: Cursor-style magazine voice. Weight 400, tight tracking -->
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-2xl text-center">
      {/* Uppercase tracked label - Cursor signature */}
      <p class="text-[11px] font-semibold uppercase tracking-[0.88px] text-muted">
        AI Agent User Group
      </p>

      {/* Display at weight 400 with negative tracking - magazine voice */}
      <h1 class="mt-6 text-5xl font-normal leading-[1.1] tracking-tight text-ink md:text-6xl dark:text-canvas">
        AIエージェントの<br />面白さを、一緒に
      </h1>

      <p class="mt-6 text-lg leading-relaxed text-body">
        プロンプトの共有、自作エージェントの自慢、最新ツールの体験。<br class="hidden md:block" />
        「AIが好き！」という気持ちがあれば、 specialist である必要はない。
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <Button href={siteConfig.communityLinks.discord} variant="primary" size="lg" target="_blank" rel="noopener noreferrer">
          <Fragment set:html={renderLucideIcon(MessageSquare, { width: 16, height: 16 })} />
          <span>コミュニティに参加</span>
        </Button>
        <Button href="/guidelines" variant="secondary" size="lg">
          <span>ポリシーを確認</span>
        </Button>
      </div>
    </div>
  </section>

  <!-- Event Calendar: 80px section rhythm, uppercase label -->
  <section class="mt-20 border-t border-hairline pt-20 dark:border-dark-hairline">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-[11px] font-semibold uppercase tracking-[0.88px] text-muted">Events</p>
      <h2 class="mt-4 text-3xl font-normal leading-[1.1] tracking-tight text-ink dark:text-canvas">イベントカレンダー</h2>
      <p class="mt-3 text-body">次回イベントの参加登録はこちらから</p>
    </div>
    <div class="mt-10">
      <Card class="overflow-hidden p-0" hover={false}>
        <div class="flex items-center gap-3 border-b border-hairline p-5 dark:border-dark-hairline">
          <div class="flex h-9 w-9 items-center justify-center rounded-md bg-primary/10 text-primary">
            <Fragment set:html={renderLucideIcon(Calendar, { width: 18, height: 18 })} />
          </div>
          <div>
            <p class="font-medium text-ink dark:text-canvas">Upcoming Events</p>
            <p class="text-xs text-muted">powered by Luma</p>
          </div>
        </div>
        <iframe
          loading="lazy"
          src={siteConfig.communityLinks.lumaCalendar}
          width="100%"
          height="450"
          style="border: 0;"
          allowfullscreen
          aria-hidden="false"
          tabindex="0"
        ></iframe>
      </Card>
    </div>
  </section>

  <!-- Latest Info -->
  <section class="mt-20 border-t border-hairline pt-20 dark:border-dark-hairline">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-[11px] font-semibold uppercase tracking-[0.88px] text-muted">Updates</p>
      <h2 class="mt-4 text-3xl font-normal leading-[1.1] tracking-tight text-ink dark:text-canvas">最新情報</h2>
      <p class="mt-3 text-body">イベントの告知や活動報告は公式Xで行っています</p>
    </div>
    <div class="mt-8 text-center">
      <Button href={siteConfig.communityLinks.x} variant="tertiary" target="_blank" rel="noopener noreferrer">
        <span>@ai_agent_ug をフォロー</span>
        <Fragment set:html={renderLucideIcon(ArrowRight, { width: 14, height: 14 })} />
      </Button>
    </div>
  </section>

  <!-- Report / Contact -->
  <ReportSection />
</BaseLayout>
