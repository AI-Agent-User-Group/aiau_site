---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { eventFlowSteps, harassmentExamples, preVisitChecks } from '../data/manners';
import { mannersPageMetadata } from '../data/site-pages';
---

<BaseLayout {...mannersPageMetadata}>
  <section class="py-6">
    <div class="inline-flex items-center gap-2 rounded-full bg-blue-50 px-4 py-1 text-sm font-medium text-blue-700 dark:bg-blue-900/30 dark:text-blue-300">
      <i class="fa-solid fa-book-open" aria-hidden="true"></i>
      <span>イベント参加者へ</span>
    </div>
    <h1 class="mt-4 text-3xl font-bold tracking-tight md:text-4xl">会場マナーガイド</h1>
    <p class="mt-3 text-lg text-gray-600 dark:text-neutral-300">初めてでも迷わないように、会場でのふるまいを場面別にまとめました。</p>
  </section>

  <section class="mt-8 rounded-xl border border-blue-200 bg-gradient-to-br from-blue-50 to-indigo-50 p-6 dark:border-blue-900/50 dark:from-blue-950/30 dark:to-indigo-950/30 md:p-8">
    <div class="flex items-start gap-3">
      <div class="flex-shrink-0 rounded-full bg-blue-600 p-3 text-white dark:bg-blue-500">
        <i class="fa-regular fa-square-check text-2xl" aria-hidden="true"></i>
      </div>
      <div class="flex-1">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">来場前チェック</h2>
        <p class="mt-2 text-sm text-gray-600 dark:text-neutral-300">家を出る前に確認しましょう</p>
      </div>
    </div>
    <ul class="mt-6 space-y-3">
      {
        preVisitChecks.map((item) => (
          <li class="flex items-start gap-3 rounded-lg bg-white/70 p-3 dark:bg-neutral-900/50">
            <i class="fa-regular fa-circle-check mt-0.5 text-xl text-blue-600 dark:text-blue-400" aria-hidden="true"></i>
            <span class="text-gray-800 dark:text-neutral-200">{item}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="mb-6 text-2xl font-bold">イベント当日の流れ</h2>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        eventFlowSteps.map((step) => (
          <div class="rounded-xl border border-gray-200 p-6 dark:border-neutral-800">
            <div class="mb-4 flex items-center gap-3">
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 text-xl font-bold text-gray-700 dark:bg-neutral-800 dark:text-neutral-300">
                {step.number}
              </div>
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-gray-50 dark:bg-neutral-900">
                <i class:list={['fa-solid', step.icon, 'text-2xl text-gray-600 dark:text-neutral-400']} aria-hidden="true"></i>
              </div>
            </div>
            <h3 class="text-lg font-bold">{step.title}</h3>
            <ul class="mt-3 space-y-2 text-sm text-gray-700 dark:text-neutral-300">
              {
                step.items.map((item) => (
                  <li class="flex gap-2">
                    <span class="text-gray-500 dark:text-neutral-400">•</span>
                    <span>{item}</span>
                  </li>
                ))
              }
              {
                step.linkedItem && (
                  <li class="flex gap-2">
                    <span class="text-gray-500 dark:text-neutral-400">•</span>
                    <span>
                      {step.linkedItem.prefix}
                      <a class="underline" href={step.linkedItem.href}>
                        {step.linkedItem.label}
                      </a>
                      {step.linkedItem.suffix}
                    </span>
                  </li>
                )
              }
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-10 rounded-xl border-2 border-yellow-300 bg-yellow-50 p-6 dark:border-yellow-700 dark:bg-yellow-950/20">
    <div class="flex items-start gap-4">
      <div class="flex-shrink-0 rounded-full bg-yellow-400 p-3 text-yellow-900">
        <i class="fa-solid fa-bullhorn text-2xl" aria-hidden="true"></i>
      </div>
      <div>
        <h2 class="text-xl font-bold text-yellow-900 dark:text-yellow-300">勧誘・営業の線引き</h2>
        <ul class="mt-3 space-y-2 text-sm text-yellow-900 dark:text-yellow-200">
          <li class="flex gap-2"><span>•</span><span>運営の許可なく宣伝・勧誘・採用活動をしたり、しつこくDMを送るのはNG（<a class="font-semibold underline" href="/code-of-conduct">行動規範</a>）</span></li>
          <li class="flex gap-2"><span>•</span><span>断られたらすぐやめる。相手の意思を最優先に</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="mt-10 rounded-xl border-2 border-red-300 bg-red-50 p-6 dark:border-red-800 dark:bg-red-950/20 md:p-8">
    <div class="flex items-start gap-4">
      <div class="flex-shrink-0 rounded-full bg-red-600 p-3 text-white dark:bg-red-700">
        <i class="fa-solid fa-heart-crack text-3xl" aria-hidden="true"></i>
      </div>
      <div class="flex-1">
        <h2 class="text-2xl font-bold text-red-900 dark:text-red-300">みんなが安心して参加できるために</h2>
        <p class="mt-2 text-sm text-red-800 dark:text-red-200">こんなことがあったら、遠慮なくスタッフに教えてください</p>
        <ul class="mt-4 space-y-3 text-red-900 dark:text-red-200">
          {
            harassmentExamples.map((example) => (
              <li class="flex gap-3 rounded-lg bg-white/60 p-3 dark:bg-red-900/20">
                <i class="fa-solid fa-xmark mt-0.5 text-xl text-red-600" aria-hidden="true"></i>
                <div>
                  <div class="font-semibold">{example.title}</div>
                  <div class="mt-1 text-xs">{example.description}</div>
                </div>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm text-red-800 dark:text-red-300">
          くわしくは <a class="font-semibold underline" href="/anti-harassment-policy">アンチハラスメントポリシー</a> と
          <a class="font-semibold underline" href="/code-of-conduct">行動規範</a> をご確認ください。
        </p>
      </div>
    </div>
  </section>

  <section class="mt-10 rounded-xl border-2 border-blue-300 bg-gradient-to-br from-blue-50 to-cyan-50 p-6 dark:border-blue-800 dark:from-blue-950/30 dark:to-cyan-950/30 md:p-8">
    <div class="flex items-start gap-4">
      <div class="flex-shrink-0 rounded-full bg-blue-600 p-3 text-white">
        <i class="fa-solid fa-circle-info text-3xl" aria-hidden="true"></i>
      </div>
      <div class="flex-1">
        <h2 class="text-2xl font-bold text-blue-900 dark:text-blue-200">困ったら（通報・相談）</h2>
        <p class="mt-2 text-blue-800 dark:text-blue-300">会場スタッフへすぐお声がけ、またはオンラインから通報できます</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href={siteConfig.communityLinks.x}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-black px-5 py-3 font-semibold text-white dark:bg-white dark:text-black"
            aria-label="XのDMを開く（新しいタブ）"
          >
            <i class="fa-brands fa-x-twitter text-xl" aria-hidden="true"></i>
            <span>公式X（DM）</span>
          </a>
          <a
            href={siteConfig.communityLinks.reportForm}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-5 py-3 font-semibold text-white dark:bg-blue-500"
            aria-label="報告フォームを開く（新しいタブ）"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 3v8h8v2h-8v8h-2v-8H3V11h8V3h2Z"></path></svg>
            <span>フォームから報告（匿名可）</span>
          </a>
        </div>
        <p class="mt-4 text-xs text-blue-700 dark:text-blue-300">
          通報者・被害者のプライバシーは最優先で保護します（<a class="font-semibold underline" href="/privacy-policy">プライバシーポリシー</a>）
        </p>
      </div>
    </div>
  </section>

  <section class="mt-10 rounded-lg border border-gray-200 p-6 text-sm text-gray-600 dark:border-neutral-800 dark:text-neutral-300">
    <p class="flex items-start gap-2">
      <i class="fa-solid fa-cloud-showers-heavy mt-0.5" aria-hidden="true"></i>
      <span>開催について：悪天候などで内容が変更・中止になることがあります（<a class="underline" href="/code-of-conduct">行動規範 第4条</a>）</span>
    </p>
    <p class="mt-3 flex items-start gap-2">
      <i class="fa-solid fa-book mt-0.5" aria-hidden="true"></i>
      <span>
        関連ページ：
        <a class="underline" href="/code-of-conduct">行動規範</a> /
        <a class="underline" href="/anti-harassment-policy">アンチハラスメントポリシー</a> /
        <a class="underline" href="/privacy-policy">プライバシーポリシー</a>
      </span>
    </p>
  </section>
</BaseLayout>
