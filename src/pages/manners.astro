---
import BaseLayout from '../layouts/BaseLayout.astro';
import { eventFlowSteps, harassmentExamples, preVisitChecks } from '../data/manners';
import { mannersPageMetadata } from '../data/site-pages';
import Card from '../components/Card.astro';
import ReportSection from '../components/ReportSection.astro';
import { renderLucideIcon } from '../lib/lucide';
import { BookOpen, CheckCircle2, AlertTriangle, HeartCrack } from 'lucide';

/* Cursor AI timeline pastels for event flow steps */
const timelineColors = [
  'bg-[#dfa88f]', // peach
  'bg-[#9fc9a2]', // mint
  'bg-[#9fbbe0]', // blue
  'bg-[#c0a8dd]', // lavender
  'bg-[#c08532]', // gold
  'bg-[#dfa88f]', // peach
];
---

<BaseLayout {...mannersPageMetadata}>
  <!-- Header -->
  <section class="py-6">
    <p class="text-[11px] font-semibold uppercase tracking-[0.88px] text-muted">
      <Fragment set:html={renderLucideIcon(BookOpen, { width: 12, height: 12, class: 'inline mr-1' })} />
      イベント参加者へ
    </p>
    {/* Display weight 400, not bold. Magazine voice. */}
    <h1 class="mt-4 text-4xl font-normal leading-[1.1] tracking-tight text-ink md:text-5xl dark:text-canvas">
      会場マナーガイド
    </h1>
    <p class="mt-4 text-lg text-body">初めてでも迷わないように、会場でのふるまいを場面別にまとめました。</p>
  </section>

  <!-- Pre-visit Checklist -->
  <section class="mt-20 border-t border-hairline pt-20 dark:border-dark-hairline">
    <div class="mx-auto max-w-2xl">
      <p class="text-[11px] font-semibold uppercase tracking-[0.88px] text-muted">Before Event</p>
      <h2 class="mt-4 text-3xl font-normal leading-[1.1] tracking-tight text-ink dark:text-canvas">来場前チェック</h2>
      <p class="mt-3 text-body">家を出る前に確認しましょう</p>
    </div>
    <ul class="mt-8 mx-auto max-w-2xl space-y-3">
      {
        preVisitChecks.map((item) => (
          <li class="flex items-start gap-3 rounded-xl border border-hairline bg-surface p-4 dark:border-dark-hairline dark:bg-dark-surface">
            <Fragment set:html={renderLucideIcon(CheckCircle2, { width: 18, height: 18, class: 'mt-0.5 text-primary flex-shrink-0' })} />
            <span class="text-ink dark:text-canvas">{item}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Event Flow: Cursor AI timeline pastels -->
  <section class="mt-20 border-t border-hairline pt-20 dark:border-dark-hairline">
    <div class="mx-auto max-w-2xl">
      <p class="text-[11px] font-semibold uppercase tracking-[0.88px] text-muted">Event Flow</p>
      <h2 class="mt-4 text-3xl font-normal leading-[1.1] tracking-tight text-ink dark:text-canvas">イベント当日の流れ</h2>
    </div>
    <div class="relative mt-10 mx-auto max-w-2xl">
      {/* Timeline line */}
      <div class="absolute left-[23px] top-0 bottom-0 w-px bg-hairline dark:bg-dark-hairline"></div>
      <div class="space-y-8">
        {
          eventFlowSteps.map((step, index) => (
            <div class="relative flex items-start gap-5">
              {/* Pastel number bubble - Cursor AI timeline signature */}
              <div class:list={[
                'relative z-10 flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl text-lg font-medium text-ink',
                timelineColors[index] ?? 'bg-[#dfa88f]'
              ]}>
                {step.number}
              </div>
              {/* Card: white on cream, hairline border, 12px radius */}
              <Card class="flex-1" hover={false}>
                <h3 class="text-lg font-medium text-ink dark:text-canvas">{step.title}</h3>
                <ul class="mt-3 space-y-2 text-sm text-body">
                  {
                    step.items.map((item) => (
                      <li class="flex gap-2">
                        <span class="text-muted">•</span>
                        <span>{item}</span>
                      </li>
                    ))
                  }
                  {
                    step.linkedItem && (
                      <li class="flex gap-2">
                        <span class="text-muted">•</span>
                        <span>
                          {step.linkedItem.prefix}
                          <a class="font-medium text-primary underline" href={step.linkedItem.href}>
                            {step.linkedItem.label}
                          </a>
                          {step.linkedItem.suffix}
                        </span>
                      </li>
                    )
                  }
                </ul>
              </Card>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Rules: merged solicitation + harassment -->
  <section class="mt-20 border-t border-hairline pt-20 dark:border-dark-hairline">
    <div class="mx-auto max-w-2xl">
      <p class="text-[11px] font-semibold uppercase tracking-[0.88px] text-muted">Guidelines</p>
      <h2 class="mt-4 text-3xl font-normal leading-[1.1] tracking-tight text-ink dark:text-canvas">守ってほしいこと</h2>
      <p class="mt-3 text-body">みんなが安心して参加できるために</p>
    </div>
    <div class="mt-8 mx-auto max-w-2xl space-y-4">
      <Card hover={false}>
        <div class="flex items-start gap-3">
          <Fragment set:html={renderLucideIcon(AlertTriangle, { width: 20, height: 20, class: 'mt-0.5 text-primary flex-shrink-0' })} />
          <div>
            <h3 class="font-medium text-ink dark:text-canvas">勧誘・営業の線引き</h3>
            <ul class="mt-2 space-y-1 text-sm text-body">
              <li>運営の許可なく宣伝・勧誘・採用活動をしたり、しつこくDMを送るのはNG（<a class="font-medium text-primary underline" href="/code-of-conduct">行動規範</a>）</li>
              <li>断られたらすぐやめる。相手の意思を最優先に</li>
            </ul>
          </div>
        </div>
      </Card>

      <Card hover={false}>
        <div class="flex items-start gap-3">
          <Fragment set:html={renderLucideIcon(HeartCrack, { width: 20, height: 20, class: 'mt-0.5 text-primary flex-shrink-0' })} />
          <div class="flex-1">
            <h3 class="font-medium text-ink dark:text-canvas">ハラスメントの禁止</h3>
            <ul class="mt-2 space-y-2 text-sm text-body">
              {
                harassmentExamples.map((example) => (
                  <li class="flex gap-2">
                    <span class="text-primary">✕</span>
                    <span>{example.title}</span>
                  </li>
                ))
              }
            </ul>
            <p class="mt-3 text-xs text-muted">
              くわしくは <a class="font-medium text-primary underline" href="/anti-harassment-policy">アンチハラスメントポリシー</a> と
              <a class="font-medium text-primary underline" href="/code-of-conduct">行動規範</a> をご確認ください。
            </p>
          </div>
        </div>
      </Card>
    </div>
  </section>

  <!-- Weather & Links -->
  <section class="mt-20 border-t border-hairline pt-20 dark:border-dark-hairline">
    <div class="mx-auto max-w-2xl text-center text-sm text-muted">
      <p>開催について：悪天候などで内容が変更・中止になることがあります（<a class="text-primary underline" href="/code-of-conduct">行動規範 第4条</a>）</p>
      <p class="mt-3">
        関連：
        <a class="text-primary underline" href="/code-of-conduct">行動規範</a> /
        <a class="text-primary underline" href="/anti-harassment-policy">アンチハラスメントポリシー</a> /
        <a class="text-primary underline" href="/privacy-policy">プライバシーポリシー</a>
      </p>
    </div>
  </section>

  <!-- Report / Contact -->
  <ReportSection />
</BaseLayout>
