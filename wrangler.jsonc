{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aiau",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-24",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
