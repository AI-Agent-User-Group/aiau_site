{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aiau",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-11",
  "workers_dev": true,
  "preview_urls": true,
  "send_metrics": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
